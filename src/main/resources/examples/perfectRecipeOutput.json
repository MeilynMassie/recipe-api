  "instructions": [
    {
      "step_number": 1,
      "description": "Melt the butter in a saucepan over medium-high heat."
    },
    {
      "step_number": 2,
      "description": "Whisk in the flour and cook for 1 minute."
    },
    {
      "step_number": 3,
      "description": "Gradually whisk in the chicken broth until smooth."
    },
    {
      "step_number": 4,
      "description": "Stir in the green chilies and simmer until the sauce thickens."
    },
    {
      "step_number": 5,
      "description": "Remove from heat and stir in the sour cream and Monterey Jack cheese."
    },
    {
      "step_number": 6,
      "description": "Combine the chicken, cream cheese, sour cream, green chilies, cumin, and cheese for the filling."
    },
    {
      "step_number": 7,
      "description": "Place filling onto each tortilla and roll tightly."
    },
    {
      "step_number": 8,
      "description": "Arrange the enchiladas seam-side down in a baking dish."
    },
    {
      "step_number": 9,
      "description": "Pour the enchilada sauce evenly over the tortillas."
    },
    {
      "step_number": 10,
      "description": "Top with the remaining Monterey Jack cheese."
    },
    {
      "step_number": 11,
      "description": "Bake until the cheese is melted and the enchiladas are heated through."
    },
    {
      "step_number": 12,
      "description": "Garnish with cilantro and serve."
    }
  ],
